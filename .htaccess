# Hesabdar - Root Apache Configuration for cPanel
# Automatically routes traffic to /public and blocks access to sensitive backend directories

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive backend directories
    RewriteRule ^(app|database|storage)/ - [F,L]
    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]

    # Rewrite requests directly into the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Disable Directory Browsing
Options -Indexes
